# Copy to backend/.env and adjust. Real environment variables override
# anything in this file. Never commit .env.

# --- Database -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://lifeops:lifeops@localhost:5432/lifeops

# --- CORS: comma-separated list of frontend origins -----------------
CORS_ORIGINS=http://localhost:5173

# Timezone used for "today" (agenda, bills, monthly summary)
APP_TIMEZONE=America/New_York

# --- Auth (single user) ---------------------------------------------
# Off by default for local development.
AUTH_ENABLED=false
APP_USERNAME=luke
# Preferred: a bcrypt hash. Generate with:
#   python scripts/hash_password.py
# Keep the single quotes: the hash contains $ characters.
APP_PASSWORD_HASH=''
# Local dev alternative to the hash (plain text). Leave empty in prod.
APP_PASSWORD=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- Market data (both have free tiers) -----------------------------
# Stocks: https://twelvedata.com (free API key)
TWELVE_DATA_API_KEY=
# Crypto: https://www.coingecko.com/en/api (free "Demo" API key)
COINGECKO_API_KEY=
MARKET_CACHE_TTL_SECONDS=60
MARKET_HTTP_TIMEOUT_SECONDS=8
